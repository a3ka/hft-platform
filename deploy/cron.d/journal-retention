# /etc/cron.d/hft-journal-retention
# M-08 rev 7, задача 14 (TD-020 доставка): планировщик В РЕПО, а не в голове оператора.
#
# Контракт:
#   - dry-run ежедневно (дефолт --mode бинаря — тоже dry-run; здесь продублировано
#     явно для документирования намерения: «по cron'у НИКОГДА apply»);
#   - лог в /var/log/hft/journal-retention.log (ротация — logrotate, см. deploy/README.md);
#   - алерт на exit≠0: `logger -p user.err` (попадает в syslog/journald → алертинг)
#     + маркер-файл /var/lib/hft/retention.alert (для healthcheck'а внешнего монитора).
#
# Apply — ВРУЧНУЮ оператором после визуального разбора отчёта dry-run'а:
#     docker compose run --rm journal-retention --mode apply
# Cron'ом apply НЕ запускается (тот же TD-020: «автоматизация без оператора = ретеншен
# без глаза = удалить единственную копию»).
#
# Расписание: ежедневно в 04:07 UTC (после резервных копий и перед утренним трафиком).
# Конкретное время — по согласованию с founder'ом (этот cron — стартовая точка).
#
# Установка:
#   sudo install -m 0644 deploy/cron.d/journal-retention /etc/cron.d/hft-journal-retention
#   sudo install -d -o hft -g hft /var/log/hft /var/lib/hft
# Удаление (revoke):
#   sudo rm /etc/cron.d/hft-journal-retention

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Cron не раскрывает ${VAR} из окружения хоста — прокидываем явно.
JOURNAL_COLD_DIR=/mnt/journal-cold
RETENTION_RETAIN_DAYS=14
RETENTION_KEEP_MIN=4
RETENTION_MIN_FREE_GB=10

# m h dom mon dow user command
07 4 * * * root cd /root/hft-platform && \
    docker compose run --rm journal-retention \
        --dir=/journal \
        --cold="${JOURNAL_COLD_DIR}" \
        --retain-days="${RETENTION_RETAIN_DAYS}" \
        --keep-min="${RETENTION_KEEP_MIN}" \
        --min-free-gb="${RETENTION_MIN_FREE_GB}" \
        --mode=dry-run \
        >> /var/log/hft/journal-retention.log 2>&1
    rc=$?; \
    if [ $rc -ne 0 ]; then \
        # D5: алерт на exit≠0 (2 = сверка холодной копии не прошла, 3 = disk_pressure).
        # Оператор ОБЯЗАН увидеть тревогу. logger идёт в syslog (journald на systemd-хостах);
        # маркер-файл — для внешнего healthcheck'а (ping /var/lib/hft/retention.alert из zabbix/nagios).
        logger -p user.err -t hft-journal-retention \
            "ALERT: dry-run exit=$rc (2=failed_cold_verify, 3=disk_pressure, 1=arg/io). Лог: /var/log/hft/journal-retention.log"; \
        install -m 0644 /dev/null /var/lib/hft/retention.alert; \
        date -u +%Y-%m-%dT%H:%M:%SZ >> /var/lib/hft/retention.alert; \
        echo "exit=$rc" >> /var/lib/hft/retention.alert; \
    else \
        # Чистим маркер на УСПЕШНОМ прогоне (следующий fail снова поднимет алерт).
        rm -f /var/lib/hft/retention.alert; \
    fi
