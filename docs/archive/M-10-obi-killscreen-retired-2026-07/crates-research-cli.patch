+
+fn half_life_from_decay(decay: &[(i64, f64)], baseline: f64) -> i64 {
+    if decay.is_empty() {
+        return 0;
+    }
+    if baseline > 0.0 {
+        if let Some((horizon, _)) = decay.iter().find(|(_, value)| *value <= baseline * 0.5) {
+            return *horizon;
+        }
+    }
+    decay.last().map(|(horizon, _)| *horizon).unwrap_or(0)
 }
 
