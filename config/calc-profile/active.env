# Профиль расчётов выдачи — ЕДИНСТВЕННЫЙ носитель определения расчёта (П-032, M-94).
# Читают ОБА процесса, считающих выдачу: gateway-serve и прогреватель gateway-checkpoint
# (путь в образе — GATEWAY_CALC_PROFILE, docker-compose.yml; доставка — COPY в Dockerfile).
# Значения v1 — эффективное прод-окружение на 2026-10-05 (docker inspect hft-gateway-serve);
# состав полос подписан П-014 п.4 и П-029, носитель — П-032.
# Правка файла — только коммитом со строкой `CALC-PROFILE-DECISION: П-NNN` в теле и ростом
# CALC_PROFILE_VERSION (барьер check_calc_profile.sh). Смена полос/каденции/таймфрейма/окна
# меняет имя слепка: сперва next.env (прогрев), потом переключение — milestones/M-94 §3.5.
CALC_PROFILE_VERSION=1
GATEWAY_BANDS=0.015,0.03,0.05,0.08,0.15,0.3,0.6
GATEWAY_DEPTH_CADENCE_MS=1000
GATEWAY_TIMEFRAME_MS=1000
GATEWAY_WINDOW_MS=60000
GATEWAY_ALLOWED_PROFILES=1000/60000/1000
GATEWAY_VP_BIN_WIDTH_E8=25000000
GATEWAY_HEATMAP_WINDOW=0.001
