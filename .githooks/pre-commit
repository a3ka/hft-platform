#!/bin/sh
# pre-commit — `git commit` без явных путей берёт ВЕСЬ индекс, включая чужое.
#
# ПОЧЕМУ БАРЬЕР, А НЕ ТЕКСТ. Правило «проверяй индекс перед коммитом» существовало 10 дней,
# запрет `commit -a` — 30; 13.08 их нарушил их же автор, унеся шесть файлов вместо одного и
# откатив работу другого агента в общей ветке. Замер аудита: у текста в правилах измеренная
# эффективность 0 на дисциплине исполнения, у механизированного правила — 90 %.
#
# КАК РАЗЛИЧАЕТСЯ ФОРМА ВЫЗОВА. Хук не видит argv, но видит `GIT_INDEX_FILE`:
#   git commit            -> index                  ОТКЛОНИТЬ (берёт весь индекс)
#   git commit -- <путь>  -> next-index-<pid>.lock  ПРОПУСТИТЬ (частичный коммит)
#   git commit -a         -> index.lock             ОТКЛОНИТЬ (уже запрещён правилами)
# Пропуск — БЕЛЫЙ список `next-index*`, иначе `commit -a` проскочит по `index.lock`.
#
# ЧТО НЕ ЗАДЕТО (замерено): merge/cherry-pick/revert/rebase — pre-commit при них не
# вызывается вовсе (82 merge за месяц); `--amend` только сообщения — пустой staged.
# Трение: из 1025 не-merge коммитов месяца 63 % трогают ровно один путь, 91 % — до трёх.
#
# ОБХОДИМ `--no-verify` и не версионируется сам по себе — это ПРЕДУПРЕЖДАЮЩИЙ контур, как
# docs-freeze, и объявляется таковым честно. Ставится `scripts/install_hooks.sh`.
set -u

GD=$(git rev-parse --absolute-git-dir 2>/dev/null) || exit 0
for m in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD REBASE_HEAD; do
  [ -e "$GD/$m" ] && exit 0
done

# Ничего не застейджено (amend сообщения, пустой коммит) — не наш случай.
git diff --cached --quiet 2>/dev/null && exit 0

case "$(basename "${GIT_INDEX_FILE:-index}")" in
  next-index*) exit 0 ;;
esac

echo "ОТКАЗ: \`git commit\` без явных путей берёт ВЕСЬ индекс — включая то, чего ты туда не клал." >&2
echo "       \`git add <файл>\` коммит НЕ сужает: он лишь ДОБАВЛЯЕТ к уже лежащему." >&2
echo "" >&2
echo "  Форма:  git commit -- <путь> [<путь>…]        (файл уже отслеживается)" >&2
echo "          git add <новый>  &&  git commit -- <новый>   (новый файл: add обязателен)" >&2
echo "" >&2
echo "  Сейчас в индексе:" >&2
git diff --cached --name-only | sed 's/^/    /' >&2
echo "" >&2
echo "  Осознанно коммитишь всё перечисленное — назови пути явно либо \`--no-verify\`." >&2
exit 1
